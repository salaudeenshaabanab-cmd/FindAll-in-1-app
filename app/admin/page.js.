'use client';

import { useState } from 'react';

export default function AdminPage() {
  const [isAdminLoggedIn, setIsAdminLoggedIn] = useState(false);
  const [passcode, setPasscode] = useState('');

  // Simple passcode gate for your store admin
  const handleLogin = (e) => {
    e.preventDefault();
    if (passcode === '1234') {
      setIsAdminLoggedIn(true);
    } else {
      alert('Incorrect passcode! Try "1234".');
    }
  };

  return (
    <div style={{ minHeight: '100vh', backgroundColor: '#f8fafc', color: '#0f172a', fontFamily: 'system-ui, sans-serif', padding: '20px' }}>
      <div style={{ maxWidth: '600px', margin: '40px auto', backgroundColor: '#ffffff', padding: '24px', borderRadius: '16px', boxShadow: '0 4px 12px rgba(0,0,0,0.05)', border: '1px solid #e2e8f0' }}>
        
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '20px', borderBottom: '1px solid #e2e8f0', paddingBottom: '12px' }}>
          <h1 style={{ fontSize: '20px', fontWeight: 900, margin: 0 }}>FindAll In 1 — Admin Portal ⚙️</h1>
          <a href="/" style={{ fontSize: '13px', color: '#2563eb', fontWeight: 'bold', textDecoration: 'none' }}>← Back to Store</a>
        </div>

        {!isAdminLoggedIn ? (
          <form onSubmit={handleLogin}>
            <p style={{ fontSize: '13px', color: '#64748b', marginBottom: '16px' }}>Please enter your admin passcode to manage inventory.</p>
            <div style={{ marginBottom: '14px' }}>
              <label style={{ display: 'block', fontSize: '11px', fontWeight: 700, color: '#475569', marginBottom: '4px' }}>Admin Passcode (Default: 1234)</label>
              <input 
                type="password" 
                value={passcode}
                onChange={(e) => setPasscode(e.target.value)}
                placeholder="Enter passcode"
                style={{ width: '100%', padding: '10px', borderRadius: '8px', border: '1px solid #cbd5e1', fontSize: '13px', outline: 'none' }}
              />
            </div>
            <button type="submit" style={{ width: '100%', backgroundColor: '#1e3a8a', color: '#ffffff', border: 'none', padding: '12px', borderRadius: '8px', fontWeight: 800, cursor: 'pointer', fontSize: '14px' }}>
              Login to Admin
            </button>
          </form>
        ) : (
          <div>
            <div style={{ backgroundColor: '#eff6ff', padding: '12px 16px', borderRadius: '10px', marginBottom: '20px' }}>
              <p style={{ fontSize: '13px', fontWeight: 700, color: '#1e3a8a', margin: 0 }}>🟢 Authenticated as Store Administrator</p>
            </div>
            <h3 style={{ fontSize: '15px', fontWeight: 800, marginBottom: '10px' }}>Quick Actions</h3>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
              <button onClick={() => alert('Feature coming soon: Add new inventory item modal.')} style={{ padding: '12px', backgroundColor: '#2563eb', color: '#fff', border: 'none', borderRadius: '8px', fontWeight: 700, cursor: 'pointer', textAlign: 'left' }}>
                ➕ Add New Product to Inventory
              </button>
              <button onClick={() => alert('All current inventory items are loaded from app/page.jsx static array.')} style={{ padding: '12px', backgroundColor: '#f1f5f9', color: '#0f172a', border: '1px solid #cbd5e1', borderRadius: '8px', fontWeight: 700, cursor: 'pointer', textAlign: 'left' }}>
                📦 View Live Inventory Status
              </button>
            </div>
          </div>
        )}

      </div>
    </div>
  );
}

